rules_version = '2';

// Security rules for https://hope.berkie.ee/staff-links/ (Firebase project hope-staff-links).
//
//   staff/{email}     Allowlist: one document per person, ID = their lowercase Google account email.
//   staffLinks/{id}   Links shown on the page: title, description, url (strings), order (number).
//
// Only allowlisted accounts signed in with Google can read staffLinks. Nothing can be written from
// the browser, and everything not matched below (including the allowlist itself) is denied. Edit
// both collections in the Firebase console, which is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower()));
    }

    match /staffLinks/{linkId} {
      allow read: if isStaff();
    }
  }
}
